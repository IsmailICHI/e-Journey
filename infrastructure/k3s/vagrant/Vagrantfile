Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.synced_folder ".", "/vagrant", create: true

  # =========================
  # K3S MASTER NODE
  # =========================
  config.vm.define "k3-master" do |master|
    master.vm.hostname = "k3-master"

    # Private cluster network
    master.vm.network "private_network", ip: "192.168.56.10"

    # Kubernetes API exposed to host
    master.vm.network "forwarded_port", guest: 6443, host: 6443

    master.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end

    master.vm.provision "shell", path: "scripts/provisions/k3-master.sh"
  end

  # =========================
  # K3S WORKER NODE
  # =========================
  config.vm.define "k3s-worker1" do |worker|
    worker.vm.hostname = "k3s-worker1"

    # Private cluster network
    worker.vm.network "private_network", ip: "192.168.56.11"

    worker.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end

    worker.vm.provision "shell",
      path: "scripts/provisions/k3-worker.sh"
  end
end



