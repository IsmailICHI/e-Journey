pipeline {
    agent any

    environment {
        IMAGE_REPOSITORY = 'ghcr.io/replace-with-your-org/e-journey-gateway'
    }

    stages {
        stage('Test') {
            steps {
                dir('services/gateway') {
                    sh './mvnw -B verify'
                }
            }
            post {
                always {
                    junit 'services/gateway/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('services/gateway') {
                        sh './mvnw -B sonar:sonar -Dsonar.projectKey=e-journey-gateway -Dsonar.projectName=e-journey-gateway'
                    }
                }
            }
        }

        stage('Build image') {
            steps {
                script {
                    env.GATEWAY_IMAGE = "${IMAGE_REPOSITORY}:${env.GIT_COMMIT.take(12)}"
                }
                sh 'docker build --file services/gateway/Dockerfile --tag "$GATEWAY_IMAGE" .'
            }
        }

        stage('Publish image') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'container-registry',
                    usernameVariable: 'REGISTRY_USER',
                    passwordVariable: 'REGISTRY_TOKEN'
                )]) {
                    sh 'echo "$REGISTRY_TOKEN" | docker login ghcr.io --username "$REGISTRY_USER" --password-stdin'
                    sh 'docker push "$GATEWAY_IMAGE"'
                    sh 'docker logout ghcr.io'
                }
            }
        }
    }
}
